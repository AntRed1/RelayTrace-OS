// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Company {
  id                   String   @id @default(cuid())
  name                 String
  email                String   @unique
  subscriptionStatus   String   @default("active")
  plan                 String   @default("starter") // starter | growth | fleet
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users          User[]
  trips          Trip[]
  alerts         Alert[]
  auditLogs      AuditLog[]
  relayEmailLogs RelayEmailLog[]

  @@index([subscriptionStatus])
}

model User {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id])

  name         String
  email        String @unique
  passwordHash String
  status       String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips     Trip[]
  auditLogs AuditLog[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([roleId])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  permissions String // JSON array: ["read:trips", "write:trips"]

  users User[]

  @@index([name])
}

model Trip {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  driverId String
  driver   User   @relation(fields: [driverId], references: [id])

  tripId        String  // ID de Amazon Relay
  status        String  @default("pending")  // pending | confirmed | flagged
  sourceType    String  @default("manual")   // manual | ocr | relay_email

  /// Azure Blob path of the screenshot (e.g. "screenshots/companyId/uuid.jpg").
  /// TripsService converts this to a SAS URL when returning trip data.
  screenshotUrl String?

  /// OCR pipeline status — updated by the OCR BullMQ processor.
  /// none       → no screenshot uploaded
  /// pending    → screenshot uploaded, job enqueued, not yet started
  /// processing → job picked up by the processor
  /// completed  → OCR finished (check OCRResult for extracted data)
  /// failed     → OCR failed after retries (check OCRResult.errorMessage)
  ocrStatus     String  @default("none")

  /// GPS coordinates captured from the driver's device at registration time.
  latitude  Float?
  longitude Float?

  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  alerts          Alert[]
  ocrResults      OCRResult[]
  reconciliations Reconciliation[]

  @@unique([companyId, tripId])
  @@index([companyId])
  @@index([driverId])
  @@index([status])
  @@index([ocrStatus])
}

model Reconciliation {
  id        String @id @default(cuid())
  companyId String

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  relayEmailLogId String
  relayEmailLog   RelayEmailLog @relation(fields: [relayEmailLogId], references: [id])

  matched           Boolean  @default(false)
  discrepancyReason String?
  checkedAt         DateTime @default(now())

  @@index([companyId])
  @@index([tripId])
  @@index([relayEmailLogId])
}

model OCRResult {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// Azure Blob path of the source screenshot used for this OCR attempt.
  /// Stored separately from Trip.screenshotUrl so the processor can
  /// re-run OCR without depending on the (potentially expired) SAS URL.
  blobPath String

  /// Pipeline status — mirrors Trip.ocrStatus for this specific attempt.
  /// pending | processing | completed | failed
  status String @default("pending")

  // ── Results (populated when status = completed) ──────────────────────────
  extractedTripId String? // the Trip ID extracted from the screenshot
  confidenceScore Float   @default(0) // 0.0 – 1.0
  rawText         String? @db.Text    // full raw text from Document Intelligence

  // ── Error info (populated when status = failed) ───────────────────────────
  errorMessage String? @db.Text

  // ── Performance ────────────────────────────────────────────────────────────
  processingTimeMs Int? // wall-clock ms from job start to finish

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([status])
}

model Alert {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  alertType String // duplicate, missing, fraud
  resolved  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([tripId])
  @@index([resolved])
}

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action    String   // login | create_trip | create_plan | …
  metadata  String   @db.Text // JSON payload
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Solicitudes de acceso enviadas desde la landing page (pre-onboarding)
model CompanyRequest {
  id          String @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  driverCount Int?
  notes       String? @db.Text
  status      String  @default("pending") // pending | approved | rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

/// Pricing plan definition — managed by SUPER_ADMIN, cached in Redis.
/// featureLabels: JSON string[]   — bullet points shown on the pricing card.
/// featureFlags:  JSON string[]   — internal PlanFeature keys consumed by PlanGuard.
model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique            // "starter" | "growth" | "fleet" | custom
  displayName     String
  description     String   @db.Text
  priceMonthly    Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  maxDrivers      Int?                        // null = unlimited
  featureLabels   String   @db.Text           // JSON: string[]  — pricing card bullets
  featureFlags    String   @db.Text           // JSON: PlanFeature[]  — access control
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false)
  sortOrder       Int      @default(0)
  ctaLabel        String   @default("Get Started")
  stripePriceId   String?                     // synced after price change
  stripeProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

/// Idempotency guard — prevents duplicate processing of Stripe webhook events
model ProcessedWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  processedAt   DateTime @default(now())

  @@index([stripeEventId])
}

model RelayEmailLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  relayTripId          String
  emailTimestamp       DateTime
  parsedData           String   @db.Text
  reconciliationStatus String   @default("pending") // pending, matched, unmatched

  createdAt DateTime @default(now())

  reconciliations Reconciliation[]

  @@index([companyId])
  @@index([relayTripId])
  @@index([reconciliationStatus])
}
