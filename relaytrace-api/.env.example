# ─────────────────────────────────────────────────────────────────────────────
# RelayTrace API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://relaytrace:password@localhost:3306/relaytrace"

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_use_openssl_rand_base64_32
JWT_REFRESH_SECRET=change_me_use_openssl_rand_base64_32
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ── Stripe (Test Mode) ───────────────────────────────────────────────────────
# Keys: Stripe Dashboard → Developers → API keys (use sk_test_... and pk_test_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret
# DEV:  stripe listen --forward-to localhost:3000/billing/webhook
# PROD: Stripe Dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — Stripe Dashboard → Products → (your plan) → Prices → copy price ID
# Each must be a recurring monthly price
STRIPE_PRICE_STARTER=price_...   # $49 / month
STRIPE_PRICE_GROWTH=price_...    # $149 / month
# Fleet plan is custom — no price ID needed (contact sales)

# ── Application ──────────────────────────────────────────────────────────────
# Base URL used in outbound email links (login button, etc.)
APP_URL=http://localhost:3001

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave blank → emails are logged to console only (dry-run mode)
# Gmail example: SMTP_HOST=smtp.gmail.com  PORT=587  USER=you@gmail.com  PASS=app_password
# SendGrid:       SMTP_HOST=smtp.sendgrid.net  PORT=587  USER=apikey  PASS=SG.xxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RelayTrace" <noreply@relaytrace.com>

# Receives internal notification whenever a new company completes registration
ADMIN_NOTIFICATION_EMAIL=admin@relaytrace.com

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Azure Blob Storage (Screenshots & OCR documents) ──────────────────────────
# Dev/Azurite: set both ACCOUNT_NAME and ACCOUNT_KEY
# Production: set only ACCOUNT_NAME (uses Managed Identity MSI)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_SCREENSHOTS=screenshots
AZURE_STORAGE_CONTAINER_OCR=ocr-documents
AZURE_STORAGE_CONTAINER_EXPORTS=exports

# ── Azure Document Intelligence (OCR) ──────────────────────────────────────────
# Azure Portal → Document Intelligence resource → Keys & Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ── Prisma Seed Configuration ──────────────────────────────────────────────────
# If not set, seed uses defaults (good for dev):
#   SEED_COMPANY_NAME=RelayTrace Admin
#   SEED_COMPANY_EMAIL=admin@relaytrace.local
#   SEED_ADMIN_NAME=Super Admin
#   SEED_ADMIN_EMAIL=admin@relaytrace.local
#   SEED_ADMIN_PASSWORD=@Emulador1
#
# For production: ALWAYS override these with real values before running seed
#
# SEED_COMPANY_NAME=Your Company
# SEED_COMPANY_EMAIL=admin@yourcompany.com
# SEED_ADMIN_NAME=John Doe
# SEED_ADMIN_EMAIL=john@yourcompany.com
# SEED_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
