# ─────────────────────────────────────────────────────────────────────────────
# RelayTrace API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/relaytrace"

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_use_openssl_rand_base64_32
JWT_REFRESH_SECRET=change_me_use_openssl_rand_base64_32
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ── Stripe ───────────────────────────────────────────────────────────────────
# Keys: Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret
# DEV:  stripe listen --print-secret  (or get from the listener output)
# PROD: Dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — Dashboard → Products → (your plan) → Prices → copy price ID
# Each must be a recurring monthly price
STRIPE_PRICE_STARTER=price_...   # $49 / month
STRIPE_PRICE_GROWTH=price_...    # $149 / month
# Fleet plan is custom — no price ID needed (handled via contact sales)

# ── Application ──────────────────────────────────────────────────────────────
# Base URL used in outbound email links (login button, etc.)
APP_URL=http://localhost:3001

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave blank → emails are logged to console only (dry-run mode)
# Gmail example: SMTP_HOST=smtp.gmail.com  PORT=587  USER=you@gmail.com  PASS=app_password
# SendGrid:       SMTP_HOST=smtp.sendgrid.net  PORT=587  USER=apikey  PASS=SG.xxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RelayTrace" <noreply@relaytrace.com>

# Receives internal notification whenever a new company completes registration
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Azure (optional — OCR and blob storage) ──────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=relaytrace
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
