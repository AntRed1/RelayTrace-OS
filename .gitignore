# ══════════════════════════════════════════════════════════════════════════════
# RelayTrace OS — root .gitignore
# Sub-projects have their own .gitignore; this file covers repo-wide rules
# and anything that doesn't belong in any sub-project.
# ══════════════════════════════════════════════════════════════════════════════

# ── Claude Code ───────────────────────────────────────────────────────────────
# .claude/ contains local project settings, hooks and conversation cache.
# CLAUDE.md is intentionally kept — it's project documentation for the AI.
.claude/
.claude/settings.local.json

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Node.js (monorepo — catches any stray node_modules at root) ───────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/
lerna-debug.log*

# ── Terraform (relaytrace-infra/) ─────────────────────────────────────────────

# Local .terraform directory — provider binaries & module cache
**/.terraform/

# Terraform state files — stored remotely in Azure Blob (never commit locally)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log (generated if terraform panics)
crash.log
crash.*.log

# Sensitive variable files at root — environments/*.tfvars ARE committed
# (they contain no secrets; secrets are passed via TF_VAR_* env vars)
terraform.tfvars
terraform.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (may contain sensitive values)
*.tfplan

# ── Azure local dev ───────────────────────────────────────────────────────────
# Azurite local storage emulator data
.azurite/
__azurite_db_blob__.json
__azurite_db_blob_extent__.json
__azurite_db_queue__.json
__azurite_db_queue_extent__.json
__azurite_db_table__.json
__azurite_db_table_extent__.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Keep .vscode/ workspace settings if they exist (shared launch configs, etc.)
# Uncomment the next line to ignore VS Code settings entirely:
# .vscode/

# ── Docker ────────────────────────────────────────────────────────────────────
# Local build artifacts — images are in Docker Hub, not the repo
*.tar
docker-compose.override.yml

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
.cache/
